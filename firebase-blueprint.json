{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile synchronized from Firebase Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address.",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "User full name.",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "User role on the platform."
        },
        "gradeLevel": {
          "type": "string",
          "description": "Target examination or teaching level.",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents isolated strictly per authenticated owner."
    }
  }
}
